+                type: 'line',
+                data: { labels: labels1, datasets: [{ label: 'Present %', data: data1, borderColor: '#0284c7', backgroundColor: 'rgba(2,132,199,0.1)', fill: true, tension: 0.3, spanGaps: true }] },
+                options: { responsive: true, scales: { y: { min:0, max:100, ticks: { callback: v => v+'%' } } }, plugins: { legend: { display: false } } }
+            });
+            // chart 2: dept avg hours
+            const deptLabels = res.dept_avg.map(x => x.dept);
+            const deptHours = res.dept_avg.map(x => (x.avg_sec/3600).toFixed(2));
+            if(c2) c2.destroy();
+            c2 = new Chart(document.getElementById('chartDept'), {
+                type: 'bar',
+                data: { labels: deptLabels, datasets: [{ label: 'Avg Hours', data: deptHours, backgroundColor: 'rgba(2,132,199,0.6)', borderColor: '#0284c7', borderWidth: 1 }]},
